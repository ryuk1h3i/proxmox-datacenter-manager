# Copy this file to .env and adjust the values.

# Initial password for the admin@pdm superuser. Only read during the first
# start, when the password store does not exist yet.
PDM_ADMIN_PASSWORD=replace-with-a-strong-password

# Image to deploy. Use a sha-<short-sha> or version tag to pin an exact build.
#PDM_IMAGE=ghcr.io/ryuk1h3i/proxmox-datacenter-manager:latest
