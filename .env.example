# Copy this file to .env and adjust the values.

# Initial password for the admin@pdm superuser. Only read during the first
# start, when the password store does not exist yet.
PDM_ADMIN_PASSWORD=replace-with-a-strong-password

# Image to deploy. Use a sha-<short-sha> or version tag to pin an exact build.
#PDM_IMAGE=ghcr.io/ryuk1h3i/proxmox-datacenter-manager:latest

# The container checks once a day whether a newer image was published on the tag
# below and reports it in the web interface. It never updates itself. Set to
# "off" to disable the check, which is the only outgoing connection to GitHub.
#PDM_UPDATE_CHECK=on

# Tag to watch for updates. Keep it aligned with the tag PDM_IMAGE is pinned to,
# otherwise the check compares against a release line you do not deploy.
#PDM_UPDATE_CHANNEL=latest
